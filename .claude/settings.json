{
  "permissions": {
    "allow": [
      "Bash(claude plugin *)",
      "Bash(python3 -m unittest discover -s tests_tools -p test_claude_file_hooks.py -v)",
      "Bash(python3 tools/check_repository.py)",
      "Bash(command -v python3.13)",
      "Bash(command -v uv)",
      "Read(//usr/bin/**)",
      "Bash(command -v pipx)",
      "Bash(command -v docker)",
      "Read(//home/roman/.cache/**)",
      "Bash(rg -n '\\\\.get\\\\\\(.*job|queue\\\\.get\\\\\\(|job\\\\.accepted|job\\\\.transition|job\\\\.finished' hostorbit tests_app web/src web/tests; rg -n 'def headers|def create_user|def other_client|class Fixture' tests_app/test_auth_api.py; ls /usr/local/bin /usr/bin | rg 'python|uv|pip')",
      "Read(//usr/local/bin/**)",
      "Bash(npm run *)",
      "Bash(apt-cache policy *)",
      "Read(//var/cache/apt/archives/**)",
      "Bash(command -v curl)",
      "Bash(command -v dpkg-deb)",
      "Bash(command -v conda)",
      "Read(//opt/**)",
      "Bash(.venv/bin/python -m unittest discover -s tests_app -p test_queue_api.py -v)",
      "Bash(.venv/bin/ruff check *)",
      "Bash(PATH=__TRACKED_VAR__/.venv/bin:__TRACKED_VAR__ HOSTORBIT_CHROMIUM=/home/roman/.cache/ms-playwright/chromium-1248/chrome-linux64/chrome npm test --prefix web)",
      "Bash(.venv/bin/python -m unittest discover -s tests_app -q)",
      "Bash(.venv/bin/python -m unittest discover -s tests -q)",
      "Bash(.venv/bin/python -m unittest discover -s tests_tools -q)",
      "Bash(.venv/bin/python -m stage0.requirements evidence/acceptance/stage0-2026-11-07/HostOrbit_Requirements_Registry_v2.3.json --gate Stage1 --evidence-root .)",
      "Bash(mktemp -d)",
      "Bash(mkdir __CMDSUB_OUTPUT__/download __CMDSUB_OUTPUT__/extracted)",
      "Bash(.venv/bin/python tools/fetch_age.py --output __CMDSUB_OUTPUT__/download/age.tar.gz)",
      "Bash(tar -xzf __CMDSUB_OUTPUT__/download/age.tar.gz -C __CMDSUB_OUTPUT__/extracted --no-same-owner --no-same-permissions)",
      "Bash(PATH=__CMDSUB_OUTPUT__/extracted/age:__TRACKED_VAR__ HOSTORBIT_TEST_AGE_DIR=__CMDSUB_OUTPUT__/extracted/age .venv/bin/python -m unittest discover -s tests -q)",
      "Bash(.venv/bin/python -m stage0.requirements evidence/acceptance/stage0-2026-11-07/HostOrbit_Requirements_Registry_v2.3.json --gate Stage0 --evidence-root .)",
      "Bash(rg --files -g '!web/node_modules')",
      "Bash(rg -n 'partial|cleanup|retention|expired|request_keys|session|idle' docs hostorbit/runtime/publication.py hostorbit/*.py)",
      "Bash(PYTHONDONTWRITEBYTECODE=1 .venv/bin/python -m unittest discover -s tests_runtime -q)",
      "Bash(npm --prefix web run build)",
      "Bash(rg --files -g 'CLAUDE.md' -g 'README*' -g '.gitignore')",
      "Bash(xargs -0 du -h)",
      "Bash(python3 -c 'import pathlib, shutil; roots=[\"deploy\",\"hostorbit\",\"stage0\",\"tests\",\"tests_app\",\"tests_runtime\",\"tests_tools\",\"tools\"]; dirs=[p for root in roots for p in pathlib.Path\\(root\\).rglob\\(\"__pycache__\"\\) if p.is_dir\\(\\) and not p.is_symlink\\(\\)]; dirs += [pathlib.Path\\(\".ruff_cache\"\\), pathlib.Path\\(\"web/test-results\"\\)]; [shutil.rmtree\\(p\\) for p in dirs]; print\\(\"Removed\", len\\(dirs\\), \"regenerable cache and test-output directories\"\\)')",
      "Bash(PYTHONDONTWRITEBYTECODE=1 .venv/bin/python tools/check_repository.py)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/file_checks.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/file_checks.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
