[Unit]
Description=VPN-Orbit durable observation Worker
Requires=vpn-orbit-broker.socket vpn-orbit-supervisor.socket
After=vpn-orbit-broker.socket vpn-orbit-supervisor.socket
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
ExecStart=/opt/vpn-orbit/venv/bin/vpn-orbit-runtime --config /etc/vpn-orbit/runtime.json worker
User=vpn-orbit-worker
Group=vpn-orbit-worker
SupplementaryGroups=vpn-orbit-app-db vpn-orbit-broker-rpc vpn-orbit-gate-rpc
UMask=0007
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=70
NoNewPrivileges=true
CapabilityBoundingSet=
LimitCORE=0
RestrictSUIDSGID=true
LockPersonality=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/vpn-orbit/app
InaccessiblePaths=/var/lib/vpn-orbit/vault /var/lib/vpn-orbit/broker /var/lib/vpn-orbit/control-gate /etc/vpn-orbit/credentials
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
