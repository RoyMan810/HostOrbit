[Unit]
Description=VPN-Orbit independent admission authority
Requires=vpn-orbit-supervisor.socket
After=vpn-orbit-supervisor.socket
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
ExecStart=/opt/vpn-orbit/venv/bin/vpn-orbit-runtime --config /etc/vpn-orbit/runtime.json supervisor
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=2
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=
LimitCORE=0
RestrictSUIDSGID=true
LockPersonality=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/vpn-orbit/control-gate /var/lib/vpn-orbit/writer-admission
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
