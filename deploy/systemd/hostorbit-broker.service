[Unit]
Description=HostOrbit scoped Secrets and SSH Broker
Requires=hostorbit-broker.socket hostorbit-supervisor.socket
After=hostorbit-broker.socket hostorbit-supervisor.socket
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
ExecStart=/opt/hostorbit/venv/bin/hostorbit-runtime --config /etc/hostorbit/runtime.json broker
User=ho-broker
Group=ho-broker
SupplementaryGroups=ho-gate-rpc
LoadCredential=broker-dek:/etc/hostorbit/credentials/broker-dek
UMask=0077
Restart=on-failure
RestartSec=2
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=
LimitCORE=0
RestrictSUIDSGID=true
LockPersonality=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/hostorbit/broker /var/lib/hostorbit/vault
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
